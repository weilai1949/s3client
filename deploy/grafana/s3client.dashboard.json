    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "存储可用性 SLI：avg_over_time(s3c_store_up[30d])，目标 ≥ 99.9% / 30 天（OPERATIONS.md §4.1）。⚠️ 仅 sqlite 驱动能实时反映故障（见右侧说明）。",
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "percentunit" },
