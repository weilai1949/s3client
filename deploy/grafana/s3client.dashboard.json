      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "s3client:s3_error_ratio:rate5m", "legendFormat": "upstream error ratio（recording rule）", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(s3c_s3_call_errors_total[5m])) / sum(rate(s3c_s3_calls_total[5m]))", "legendFormat": "upstream error ratio（raw）", "refId": "B" }
