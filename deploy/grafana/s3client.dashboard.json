      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg_over_time(s3c_store_up[30d])", "legendFormat": "store availability (30d)", "refId": "A" }
      ],
      "title": "存储可用性（30 天均值）",
      "type": "timeseries"
