    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "上游调用 p95 延迟，SLO ≤ 2s（OPERATIONS.md §4.1）。记录规则失败或未加载时用 refId B 的原始 histogram_quantile。",
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
