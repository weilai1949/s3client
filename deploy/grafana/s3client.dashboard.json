    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "SLO 目标 ≤ 0.5%（OPERATIONS.md §4.1）。优先取 recording rule s3client:http_5xx_ratio:rate5m（rules.yml 与本面板同源）；refId B 是等价原始表达式，规则未加载时仍可读。",
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "s3client:http_5xx_ratio:rate5m", "legendFormat": "5xx ratio（recording rule）", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(s3c_http_responses_total{class=\"5xx\"}[5m])) / sum(rate(s3c_http_requests_total[5m]))", "legendFormat": "5xx ratio（raw）", "refId": "B" }
      ],
      "title": "服务端 5xx 比例（SLO ≤ 0.5%）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "全部已处理 HTTP 请求的速率（所有状态码）。这是错误率的分母。",
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(s3c_http_requests_total[5m]))", "legendFormat": "requests/s", "refId": "A" }
      ],
      "title": "HTTP 请求速率",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "按状态类分桶的响应速率。5xx 升高对应上方 SLO 面板；4xx 持续升高通常来自鉴权失败或客户端误用。",
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (class) (rate(s3c_http_responses_total[5m]))", "legendFormat": "{{class}}", "refId": "A" }
      ],
      "title": "HTTP 响应速率（按状态类）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "上游错误率 SLO ≤ 1%（OPERATIONS.md §4.1）。canceled 属客户端取消，可在评估时剔除。",
