        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(s3c_s3_call_duration_seconds_sum[5m])) / sum(rate(s3c_s3_call_duration_seconds_count[5m]))", "legendFormat": "avg latency", "refId": "A" }
