        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(s3c_http_requests_total[5m]))", "legendFormat": "requests/s", "refId": "A" }
      ],
      "title": "HTTP 请求速率",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "按状态类分桶的响应速率。5xx 升高对应上方 SLO 面板；4xx 持续升高通常来自鉴权失败或客户端误用。",
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
