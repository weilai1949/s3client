# s3client docker compose / 本地联调环境变量
# 复制为仓库根目录 .env：cp .env.example .env
#
# 用法：只填**未注释的必填项**——`#` 开头的行不会被读取（= 用 compose 内置默认值）。
# ⚠️ 解析规则：`#` 仅在**行首**才是注释；**不要写行内注释**——`S3C_LOG_LEVEL=info # 说明`
#    的值会是整串 `info # 说明`（见 docs/CONFIGURATION.md §1）。说明请单独成行。
#
# 口径（见 docs/CONFIGURATION.md §1）：本文件**只列 compose 会用到的变量**——即
# docker-compose*.yml 里以 ${VAR} 插值的键（含构建参数与镜像 tag）。
# compose 的 environment: 是**显式白名单**且无 env_file:，因此未写进白名单的 S3C_*
# 即使出现在本文件也不会进入容器；服务端全量可选项见 apps/server/.env.example。
# 该双向一致性由 apps/server/env_example_gate_test.go 守住。

# ---- 必填（compose 守卫 ${VAR:?} 会在空值时拒绝启动）----

# API 鉴权。生成：openssl rand -hex 32
# 必须留空：占位值只要 ≥16 字符就是一枚「公开已知的有效口令」，照 README 快速开始会以它上线。
S3C_TOKEN=

# 账号存储驱动：json（默认）| sqlite（accounts.db）| encrypted（整文件 accounts.json.enc）。
# base compose 默认 sqlite；prod compose 固定 encrypted。
S3C_STORE_DRIVER=sqlite
# 必填：至少 16 字符；生成：openssl rand -hex 32
# 安全默认：json / sqlite 且本值为空时服务端**拒绝启动**（防 secretKey 明文落盘）。
S3C_STORE_KEY=

# ---- 可选覆盖（注释掉即用 compose 内置默认值）----

# 账号缺省 region（账号可单独覆盖）；compose 默认 us-east-1
# S3C_REGION=us-east-1
# 日志级别：debug | info | warn | error；compose 默认 info
# S3C_LOG_LEVEL=info
# 结构化日志（容器/生产更易采集）；compose 默认 1，设 0 退回纯文本
# S3C_LOG_JSON=1
# 浏览器可达的后端 CORS Origin 白名单（逗号分隔；留空 = 仅 localhost/tauri；勿用 *）
# 注意：这不是 RUSTFS_CORS_ORIGINS（那是 RustFS 容器自己的 CORS）
# S3C_CORS_ORIGINS=http://127.0.0.1:5000
# SIGTERM 后等待活跃 HTTP 连接结束的秒数，取值 1–3600；compose 默认 30
# S3C_SHUTDOWN_TIMEOUT=30
# 生产镜像 tag（仅 docker-compose.prod.yml 使用）；默认 v1.0.0
# S3C_IMAGE_TAG=v1.0.0

# 构建加速（compose build args，默认走官方源）
# GOPROXY=https://goproxy.io,direct
# NPM_REGISTRY=https://registry.npmmirror.com

# ---- 本地 RustFS 联调凭据（勿用于生产；生产请移除 rustfs 服务）----

RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
# 浏览器可达的 Origin（收紧 RustFS CORS；勿用 *）
RUSTFS_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
