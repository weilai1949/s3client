# s3clinet docker compose / 本地联调环境变量
# 复制为仓库根目录 .env：cp .env.example .env

# 必填：API 鉴权（compose 内 server 监听 0.0.0.0，无 token 会拒绝启动）
# 生成：openssl rand -hex 32
S3C_TOKEN=change-me-use-openssl-rand-hex-32

# 日志：S3C_LOG_LEVEL=info|debug|warn|error
# compose 已默认开启结构化日志（S3C_LOG_JSON=1）；设 0 退回纯文本。
# S3C_LOG_JSON=1

# 账号存储（生产建议 encrypted + S3C_STORE_KEY；至少设置 S3C_STORE_KEY）
# - sqlite + S3C_STORE_KEY：secret_key 列以 AES-256-GCM 密文落盘
# - encrypted：整文件加密（accounts.json.enc），必须 S3C_STORE_KEY
# - 不设 key 时为明文，仅限本地联调
S3C_STORE_DRIVER=sqlite
# 至少 16 字符；生成：openssl rand -hex 32
# S3C_STORE_KEY=

# 本地 RustFS 联调凭据（勿用于生产；生产请移除 rustfs 服务）
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
# 浏览器可达的 Origin（收紧 CORS；勿用 *）
RUSTFS_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# 可信反向代理 IP（逗号分隔）；仅这些对端的 X-Forwarded-For 被采信。
# compose 内 server 经 nginx 转发，nginx 容器 IP 因网络而异，故默认留空（不信任 XFF）；
# 直连部署请保持留空，避免伪造 XFF 绕过限速。
# S3C_TRUSTED_PROXIES=

# 可选 SSRF 加固：设为 1 时连私网 / 回环 S3 端点也拒绝。
# 默认关闭（自托管 MinIO / RustFS / 局域网是主场景，见 docs/decisions/0003-ssrf-private-allow.md）。
# S3C_SSRF_DENY_PRIVATE=
