{
  "name": "s3clinet-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src e2e e2e-real --max-warnings 0",
    "typecheck:e2e": "vue-tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium --with-deps",
    "e2e:ci": "PLAYWRIGHT_NO_WEBSERVER=1 playwright test",
    "e2e:real": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^20.12.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.1.0",
    "vue-tsc": "^2.2.8"
  }
}
