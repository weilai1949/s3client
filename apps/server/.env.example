# ===== s3client server 环境变量示例 =====
# 复制为 .env 或直接用环境变量导出。
# .env 查找顺序：S3C_ENV_FILE 指定路径（若设置则为唯一来源，且路径不存在/不可读时拒绝启动）→ 进程工作目录 .env → 可执行文件同目录 .env。
#
# 用法：只填**未注释的必填项**——`#` 开头的行不会被读取（= 走安全默认值）。
# ⚠️ 解析规则：`#` 仅在**行首**才是注释；**不要写行内注释**——`S3C_LOG_LEVEL=info # 说明`
#    的值会是整串 `info # 说明`（见 docs/CONFIGURATION.md §1）。说明请单独成行。

# 可选：显式指定 .env 路径（绝对路径可与进程 CWD 解耦，适合 systemd/容器）
# 路径不存在或不可读会拒绝启动：否则写在里面的加固项/数据目录会静默失效。
# S3C_ENV_FILE=/etc/s3client/.env

# 监听地址（默认 127.0.0.1:5000，绑定回环更安全；需局域网/远程时改为 0.0.0.0:5000）
S3C_ADDR=127.0.0.1:5000

# 数据目录（存放 accounts.json）
S3C_DATA_DIR=./data

# Web 静态资源目录（构建产物；相对进程工作目录。`cd apps/server` 启动时为 ../web/dist）
S3C_STATIC_DIR=../web/dist

# 账号缺省 region（账号可单独覆盖）
S3C_REGION=us-east-1

# 可选：API 鉴权 Token。非空时所有 /api/* 需携带 Authorization: Bearer <token>
# 生成：openssl rand -hex 32
# 多 token 轮换：逗号分隔，如 tokA,tokB（去掉旧值即吊销）
# 注意：S3C_ADDR 为非回环（如 0.0.0.0）时必须设置，否则进程拒绝启动。
S3C_TOKEN=

# 可选：按 token 的最小权限（JSON）。键必须出现在上面的 S3C_TOKEN 列表里；未登记的 token 保持全权。
# 字段全部可选、缺省即不限制：readonly（仅 GET/HEAD）、prefixes（"<bucket>" 或 "<bucket>/<key前缀>"）、
# accounts（路径 {id} 白名单）、expiresAt（RFC3339；过期返回 401）。
# 非法 JSON / 未知字段 / 未登记 token / 空元素 / 坏时间一律拒绝启动（fail-closed）。
# 示例：S3C_TOKEN_SCOPES={"tokB":{"readonly":true,"prefixes":["bucket-a/","bucket-b/logs/"],"expiresAt":"2027-01-01T00:00:00Z"}}
# S3C_TOKEN_SCOPES=

# 可选：CORS 白名单（逗号分隔的 Origin 列表）。留空则使用安全默认
#（仅放行同源 + localhost/127.0.0.1/tauri 自定义协议跨域）。
# 示例：S3C_CORS_ORIGINS=https://app.example.com,http://192.168.1.10:1949
# 或 S3C_CORS_ORIGINS=* （不推荐，仅确认明白风险时使用）
S3C_CORS_ORIGINS=

# 日志级别：debug | info | warn | error
S3C_LOG_LEVEL=info
# 可选：JSON 日志（容器/生产更易采集）：S3C_LOG_JSON=1
# 注意：docker compose 已默认注入 S3C_LOG_JSON=1；设 0 可覆盖回纯文本。
# S3C_LOG_JSON=1

# 收到 SIGTERM 后等待活跃 HTTP 连接结束的最长时间（秒）；大文件传输可适当加大（上限 3600，超上界拒绝启动）
S3C_SHUTDOWN_TIMEOUT=30

# 账号存储：json（默认）| sqlite（accounts.db）| encrypted（AES-256-GCM accounts.json.enc，格式 S3C3，兼容读 S3C2）
# encrypted 需设置 S3C_STORE_KEY；sqlite + S3C_STORE_KEY 时 secret_key 列加密
# 安全默认：json / sqlite 且 S3C_STORE_KEY 为空时进程**拒绝启动**（防止 secretKey 明文落盘）。
# S3C_STORE_KEY 非空时至少 16 字符（openssl rand -hex 32）
S3C_STORE_DRIVER=json
S3C_STORE_KEY=

# 仅本地联调：显式允许 json / sqlite 在无 S3C_STORE_KEY 时明文落盘 secretKey。
# 默认关闭（安全默认）；设为 1 时启动日志会打出「明文落盘」WARN。生产绝不要开启。
# S3C_ALLOW_PLAINTEXT_STORE=

# 可信反向代理 IP（逗号分隔）；仅这些对端的 X-Forwarded-For 被采信用于限速与审计。
# 留空 = 完全不信任 XFF（直连部署应保持留空，防伪造绕过限速）。
# S3C_TRUSTED_PROXIES=

# 可选 SSRF 加固：设为 1 时连私网 / 回环 S3 端点也拒绝（默认关闭，见 ADR-003）。
# S3C_SSRF_DENY_PRIVATE=

# 可选：暴露 Prometheus 指标端点（默认关闭 → GET /api/metrics 返回 404）。
# ⚠️ 该端点**不受 S3C_TOKEN 保护**，开启后匿名可读（含版本 / 存储可达性 / S3 调用统计），
# 只应在内网或反向代理鉴权之后开启。
# S3C_EXPOSE_METRICS=1

# 可选：暴露 API 契约端点（默认关闭 → GET /api/openapi.json 返回 404），避免公网泄露端点信息。
# 开启后仍经鉴权层：配了 S3C_TOKEN 时无 token 访问返回 401。
# S3C_EXPOSE_OPENAPI=1

# 可选：覆盖 CSP 的 connect-src（前端可连接的后端地址，空格分隔）。
# 默认仅同源 + 本地 Tauri 后端（'self' http://127.0.0.1:* http://localhost:*）；
# 多后端 / 远程后端需显式放宽，否则浏览器按 CSP 拦截。
# 示例：S3C_CSP_CONNECT_SRC='self' http://127.0.0.1:* http://localhost:* https://s3.example.com
# S3C_CSP_CONNECT_SRC=

# 可选：OpenTelemetry tracing（OTLP/HTTP JSON，零第三方依赖）。**默认关闭**：
# S3C_OTEL_ENDPOINT 留空即禁用（中间件原样透传、不注入响应头、不导出，零开销）。
# 开启后导出到 POST {Endpoint}/v1/traces（标准 OTLP 采集端，如 otel-collector:4318）。
# 非 http(s) URL 会拒绝启动。详见 docs/OPERATIONS.md「OTel tracing」。
# S3C_OTEL_ENDPOINT=http://127.0.0.1:4318

# 新建 trace 的采样比例，取值 [0,1]，默认 1（全量）。入站 traceparent 的采样位被继承：
# 上游标了 01 即使此处为 0 也采样；标了 00 则不导出（不做尾部采样）。
# S3C_OTEL_SAMPLE_RATIO=1

# OTLP resource attribute service.name（默认 s3client），用于采集端区分服务来源。
# S3C_OTEL_SERVICE_NAME=s3client
